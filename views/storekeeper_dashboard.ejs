<body>

<div class="navbar">
    <h2>نظام المخازن - أمين المخزن</h2>
    <ul>
        <li><a href="/storekeeper/dashboard">الرئيسية</a></li>
        <li><a href="/storekeeper/warehouse">المخازن</a></li>
        <li><a href="/account">حسابي</a></li>
        <li><a href="/logout" class="logout-btn">تسجيل خروج</a></li>
    </ul>
</div>

<div class="container">
    <% if (locals.error && error) { %>
        <div class="alert-error"><%= error %></div>
    <% } %>

    <h3><%= editStore ? 'تعديل حركة صرف مخزنية' : 'تسجيل صرف من المخزن' %></h3>
    <form action="<%= editStore ? '/storekeeper/update/' + editStore.id : '/storekeeper/add' %>" method="POST">
        <div class="form-row">
            <div class="form-group">
                <label>اختر الصنف من المخزن</label>
                <select name="item_name" required>
                    <option value="">-- اختار الصنف --</option>
                    <% if (items && items.length > 0) { %>
                        <% items.forEach(item => { %>
                            <option value="<%= item.item_name %>" <%= editStore && editStore.item_name === item.item_name ? 'selected' : '' %>>
                                <%= item.item_name %> (المتاح: <%= item.quantity %>)
                            </option>
                        <% }) %>
                    <% } %>
                </select>
            </div>
            <div class="form-group">
                <label>الكمية المصروفة</label>
                <input type="number" name="quantity" value="<%= editStore ? editStore.quantity : '' %>" required min="1">
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>اسم المستلم</label>
                <input type="text" name="receiver" value="<%= editStore ? editStore.receiver : '' %>" required>
            </div>
            <div class="form-group">
                <label>القسم / الجهة</label>
                <input type="text" name="department" value="<%= editStore ? editStore.department : '' %>" required>
            </div>
            <div class="form-group">
                <label>تاريخ الصرف</label>
                <input type="date" name="date" value="<%= editStore ? editStore.date : '' %>" required>
            </div>
        </div>
        <button type="submit" class="btn-add"><%= editStore ? 'تحديث الحركة' : 'تسجيل وحفظ الصرف' %></button>
        <% if (editStore) { %>
            <a href="/storekeeper/dashboard" style="margin-right: 10px; color: #dc3545; text-decoration: none;">إلغاء التعديل</a>
        <% } %>
    </form>

    <h3 style="margin-top: 40px;">سجل الحركات المصروفة من المخزن</h3>
    <table>
        <thead>
            <tr>
                <th>المسلسل</th>
                <th>اسم الصنف</th>
                <th>الكمية</th>
                <th>اسم المستلم</th>
                <th>الجهة / القسم</th>
                <th>تاريخ الصرف</th>
                <th>التحكم</th>
            </tr>
        </thead>
        <tbody>
            <% if (transactions && transactions.length > 0) { %>
                <% transactions.forEach((tx, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><%= tx.item_name %></td>
                        <td><%= tx.quantity %></td>
                        <td><%= tx.receiver %></td>
                        <td><%= tx.department %></td>
                        <td><%= tx.date %></td>
                        <td>
                            <div class="action-cell">
                                <a href="/storekeeper/edit/<%= tx.id %>" class="edit-link">✏️ تعديل</a>
                                <a href="/storekeeper/delete/<%= tx.id %>" class="delete-link" onclick="return confirm('هل أنت متأكد من الحذف؟ سيتم إرجاع الكمية للمخزن تلقائياً')">🗑️ حذف</a>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <% /* Source 1 */ %>
                <tr>
                    <td colspan="7">لا توجد حركات مسجلة حتى الآن</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

</body>
</html> -->