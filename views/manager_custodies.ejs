<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>تقرير العهد المنصرفة - جامعة مدينة السادات</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .print-header { display: none; }

        @media print {
            .no-print, .btn, .navbar, .store-filter-box, form { display: none !important; }
            body { background: white !important; font-size: 12pt; }
            .container { max-width: 100% !important; width: 100% !important; padding: 0 !important; margin: 0 !important; }
            .card { border: none !important; box-shadow: none !important; }
            
            .print-header {
                display: flex !important;
                justify-content: space-between;
                align-items: center;
                border-bottom: 2px solid #000;
                padding-bottom: 15px;
                margin-bottom: 20px;
            }
            .print-header img { max-height: 80px; width: auto; }
            
            table { width: 100% !important; border: 1px solid #000 !important; }
            th, td { border: 1px solid #000 !important; padding: 6px !important; }
            th { background-color: #f2f2f2 !important; color: #000 !important; }

            .print-signatures {
                display: flex !important;
                justify-content: space-between;
                margin-top: 40px;
                padding: 0 20px;
            }
        }
        .print-signatures { display: none; }
    </style>
</head>
<body class="bg-light">
    <div class="container py-4">

        <!-- هيدر الطباعة الرسمي باللوجو -->
        <div class="print-header">
            <div style="text-align: right;">
                <h5 class="m-0 fw-bold">جامعة مدينة السادات</h5>
                <p class="m-0 small">إدارة المخازن والعهدة</p>
                <p class="m-0 small">المخزن: <%= selectedStore === 'الكل' ? 'جميع المخازن' : selectedStore %></p>
            </div>
            <div class="text-center">
                <img src="/images/logo.png" alt="لوجو الجامعة" onerror="this.style.display='none'">
                <h4 class="mt-2 fw-bold">بيان العهدة المنصرفة</h4>
                <% if (searchVal) { %>
                    <p class="m-0 fw-bold">خاص بـ: <%= searchVal %></p>
                <% } %>
            </div>
            <div style="text-align: left;">
                <p class="m-0 small">التاريخ: <%= new Date().toLocaleDateString('ar-EG') %></p>
                <p class="m-0 small">اعتماد: مدير المخازن</p>
            </div>
        </div>

        <!-- الشريط العلوي الشاشي -->
        <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm no-print">
            <h2>سجل العهد المنصرفة</h2>
            <div>
                <button onclick="window.print()" class="btn btn-success btn-sm me-2">🖨️ طباعة بيان العهدة</button>
                <a href="/manager/dashboard?store=<%= selectedStore %>" class="btn btn-secondary btn-sm">العودة للرئيسية</a>
            </div>
        </div>

        <!-- أزرار تصفية المخازن والبحث -->
        <div class="bg-white p-3 rounded shadow-sm mb-4 store-filter-box no-print">
            <div class="d-flex justify-content-center gap-2 flex-wrap align-items-center mb-3">
                <span class="fw-bold me-2">عرض عهد:</span>
                <a href="/manager/custodies?store=الكل&search=<%= searchVal %>" class="btn <%= selectedStore === 'الكل' ? 'btn-dark' : 'btn-outline-dark' %> btn-sm px-3"> جميع العهد</a>
                <a href="/manager/custodies?store=مستهلك&search=<%= searchVal %>" class="btn <%= selectedStore === 'مستهلك' ? 'btn-success' : 'btn-outline-success' %> btn-sm px-3"> مخزن المستهلك</a>
                <a href="/manager/custodies?store=مستديم&search=<%= searchVal %>" class="btn <%= selectedStore === 'مستديم' ? 'btn-success' : 'btn-outline-success' %> btn-sm px-3"> مخزن المستديم</a>
                <a href="/manager/custodies?store=كيماويات&search=<%= searchVal %>" class="btn <%= selectedStore === 'كيماويات' ? 'btn-success' : 'btn-outline-success' %> btn-sm px-3"> مخزن الكيماويات</a>
            </div>

            <!-- البحث باسم المستلم أو الصنف -->
            <form action="/manager/custodies" method="GET" class="row g-2 justify-content-center">
                <input type="hidden" name="store" value="<%= selectedStore %>">
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" name="search" class="form-control" placeholder="ابحث باسم المستلم أو اسم الصنف..." value="<%= searchVal %>">
                        <button type="submit" class="btn btn-success">🔍 بحث</button>
                        <% if (searchVal) { %>
                            <a href="/manager/custodies?store=<%= selectedStore %>" class="btn btn-outline-secondary">إلغاء البحث</a>
                        <% } %>
                    </div>
                </div>
            </form>
        </div>

        <!-- جدول العهد -->
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center no-print">
                <span>سجل العهد المنصرفة (<%= selectedStore === 'الكل' ? 'جميع المخازن' : selectedStore %>)</span>
                <span class="badge bg-light text-dark">عدد السجلات: <%= custodies.length %></span>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-striped table-hover text-center align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>رقم الصنف</th>
                            <th>اسم الصنف</th>
                            <th>المخزن</th>
                            <th>الكمية المصروفة</th>
                            <th>اسم المستلم</th>
                            <th>القسم</th>
                            <th>تاريخ الصرف</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (custodies && custodies.length > 0) { %>
                            <% custodies.forEach((custody, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><strong><%= custody.item_number || '-' %></strong></td>
                                    <td><%= custody.item_name %></td>
                                    <td>
                                        <% 
                                            // قراءة نوع المخزن الفعلي المجلوب من جدول الأصناف عبر الـ LEFT JOIN
                                            const itemStore = custody.real_store_type || custody.store_type || 'مستهلك'; 
                                        %>
                                        <% if (itemStore === 'مستديم') { %>
                                            <span class="badge bg-secondary">مستديم</span>
                                        <% } else if (itemStore === 'كيماويات') { %>
                                            <span class="badge bg-warning text-dark">كيماويات</span>
                                        <% } else { %>
                                            <span class="badge bg-info text-dark">مستهلك</span>
                                        <% } %>
                                    </td>
                                    <td><span class="badge bg-primary fs-6"><%= custody.quantity %></span></td>
                                    <td><strong><%= custody.receiver %></strong></td>
                                    <td><%= custody.department %></td>
                                    <td><%= custody.date %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-muted py-4">لا توجد عهد منصرفة مسجلة <%= selectedStore === 'الكل' ? '' : 'في ' + selectedStore %> حتى الآن.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- التوقيعات الرسمية في الورقة المطبوعة -->
        <div class="print-signatures">
            <div class="text-center">
                <p class="fw-bold mb-4">مستلم العهدة</p>
                <p>الاسم: ........................</p>
                <p>التوقيع: ........................</p>
            </div>
            <div class="text-center">
                <p class="fw-bold mb-4">مسئول العهد</p>
                <p>الاسم: ........................</p>
                <p>التوقيع: ........................</p>
            </div>
            <div class="text-center">
                <p class="fw-bold mb-4">يعتمد، مدير المخازن</p>
                <p>الاسم: ........................</p>
                <p>التوقيع: ........................</p>
            </div>
        </div>

    </div>
</body>
</html>