<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>لوحة تحكم مدير المخازن</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm">
            <h2>لوحة تحكم مدير المخازن</h2>
            <div>
                <a href="/logout" class="btn btn-danger btn-sm">تسجيل الخروج</a>
            </div>
        </div>

        <!-- أزرار اختيار وتصفية المخازن للمدير -->
        <div class="bg-white p-3 rounded shadow-sm mb-4">
            <div class="d-flex justify-content-center gap-2 flex-wrap align-items-center">
                <span class="fw-bold me-2">تصفية حسب المخزن:</span>
                <a href="/manager/dashboard?store=الكل" class="btn <%= selectedStore === 'الكل' ? 'btn-dark' : 'btn-outline-dark' %> btn-sm px-3">
                     إجمالي كل المخازن
                </a>
                <a href="/manager/dashboard?store=مستهلك" class="btn <%= selectedStore === 'مستهلك' ? 'btn-primary' : 'btn-outline-primary' %> btn-sm px-3">
                     مخزن المستهلك
                </a>
                <a href="/manager/dashboard?store=مستديم" class="btn <%= selectedStore === 'مستديم' ? 'btn-primary' : 'btn-outline-primary' %> btn-sm px-3">
                     مخزن المستديم
                </a>
                <a href="/manager/dashboard?store=كيماويات" class="btn <%= selectedStore === 'كيماويات' ? 'btn-primary' : 'btn-outline-primary' %> btn-sm px-3">
                     مخزن الكيماويات
                </a>
            </div>
        </div>

        <div class="row mb-4">
            <!-- بطاقة إجمالي الأصناف -->
            <div class="col-md-3 mb-3">
                <div class="card text-white bg-primary shadow-sm h-100">
                    <div class="card-body text-center">
                        <h5 class="card-title">إجمالي الأصناف</h5>
                        <p class="card-text fs-3 fw-bold"><%= itemCount %></p>
                        <small class="d-block mb-2 text-white-50">(<%= selectedStore === 'الكل' ? 'جميع المخازن' : selectedStore %>)</small>
                        <a href="/manager/items?store=<%= selectedStore %>" class="btn btn-light btn-sm mt-2">عرض الأصناف</a>
                    </div>
                </div>
            </div>

            <!-- بطاقة سجل العهد المنصرفة -->
            <div class="col-md-3 mb-3">
                <div class="card text-white bg-success shadow-sm h-100">
                    <div class="card-body text-center">
                        <h5 class="card-title">سجل العهد المنصرفة</h5>
                        <p class="card-text fs-3 fw-bold"><%= custodyCount %></p>
                        <small class="d-block mb-2 text-white-50">(<%= selectedStore === 'الكل' ? 'جميع المخازن' : selectedStore %>)</small>
                        <a href="/manager/custodies?store=<%= selectedStore %>" class="btn btn-light btn-sm mt-2">عرض العهد والبحث</a>
                    </div>
                </div>
            </div>

            <!-- بطاقة إجمالي قيمة المخزن -->
            <div class="col-md-3 mb-3">
                <div class="card text-white bg-warning shadow-sm h-100">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <h5 class="card-title">💰 قيمة المخزن</h5>
                        <p class="card-text fs-3 fw-bold my-1">
                            <%= typeof totalInventoryValue !== 'undefined' ? totalInventoryValue.toLocaleString() : 0 %> ج.م
                        </p>
                        <small class="text-white">(<%= selectedStore === 'الكل' ? 'إجمالي تكلفة كل الأصناف' : 'تكلفة أصناف ' + selectedStore %>)</small>
                    </div>
                </div>
            </div>

            <!-- بطاقة مستخدمي النظام -->
            <div class="col-md-3 mb-3">
                <div class="card text-white bg-info shadow-sm h-100">
                    <div class="card-body text-center">
                        <h5 class="card-title">مستخدمو النظام</h5>
                        <p class="card-text fs-3 fw-bold"><%= userCount %></p>
                        <small class="d-block mb-2 text-white-50">(جميع الصلاحيات)</small>
                        <a href="/manager/users" class="btn btn-light btn-sm mt-2">إدارة المستخدمين</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>