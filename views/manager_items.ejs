<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>تقرير أصناف المخازن - جامعة مدينة السادات</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* هيدر التقرير الرسمي - يخفى في الشاشة ويظهر في الطباعة */
        .print-header { display: none; }

        @media print {
            /* إخفاء الأزرار والشريط العلوي وأزرار التصفية عند الطباعة */
            .no-print, .btn, .navbar, .store-filter-box { display: none !important; }
            body { background: white !important; font-size: 12pt; }
            .container { max-width: 100% !important; width: 100% !important; padding: 0 !important; margin: 0 !important; }
            .card { border: none !important; box-shadow: none !important; }
            
            /* إظهار هيدر الجامعة واللوجو */
            .print-header {
                display: flex !important;
                justify-content: space-between;
                align-items: center;
                border-bottom: 2px solid #000;
                padding-bottom: 15px;
                margin-bottom: 20px;
            }
            .print-header img { max-height: 80px; width: auto; }
            .print-header .univ-title { text-align: center; }
            
            table { width: 100% !important; border: 1px solid #000 !important; }
            th, td { border: 1px solid #000 !important; padding: 6px !important; }
            th { background-color: #f2f2f2 !important; color: #000 !important; }
        }
    </style>
</head>
<body class="bg-light">
    <div class="container py-4">

        <!-- هيدر الطباعة الرسمي (جامعة مدينة السادات + اللوجو) -->
        <div class="print-header">
            <div style="text-align: right;">
                <h5 class="m-0 fw-bold">جامعة مدينة السادات</h5>
                <p class="m-0 small">الإدارة العامة للمخازن</p>
                <p class="m-0 small">مخزن: <%= selectedStore === 'الكل' ? 'جميع المخازن' : selectedStore %></p>
            </div>
            <div class="univ-title">
                <img src="/images/logo.png" alt="لوجو الجامعة" onerror="this.style.display='none'">
                <h4 class="mt-2 fw-bold">تقرير جرد الأصناف</h4>
            </div>
            <div style="text-align: left;">
                <p class="m-0 small">التاريخ: <%= new Date().toLocaleDateString('ar-EG') %></p>
                <p class="m-0 small">المطبع: مدير المخازن</p>
            </div>
        </div>

        <!-- الشريط العلوي الشاشي -->
        <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm no-print">
            <h2>قائمة الأصناف بالمخازن</h2>
            <div>
                <!-- زر الطباعة -->
                <button onclick="window.print()" class="btn btn-success btn-sm me-2">🖨️ طباعة التقرير</button>
                <a href="/manager/dashboard?store=<%= selectedStore %>" class="btn btn-secondary btn-sm">العودة للرئيسية</a>
            </div>
        </div>

        <!-- أزرار تصفية الأصناف -->
        <div class="bg-white p-3 rounded shadow-sm mb-4 store-filter-box no-print">
            <div class="d-flex justify-content-center gap-2 flex-wrap align-items-center">
                <span class="fw-bold me-2">عرض أصناف:</span>
                <a href="/manager/items?store=الكل" class="btn <%= selectedStore === 'الكل' ? 'btn-dark' : 'btn-outline-dark' %> btn-sm px-3"> جميع الأصناف</a>
                <a href="/manager/items?store=مستهلك" class="btn <%= selectedStore === 'مستهلك' ? 'btn-primary' : 'btn-outline-primary' %> btn-sm px-3"> مخزن المستهلك</a>
                <a href="/manager/items?store=مستديم" class="btn <%= selectedStore === 'مستديم' ? 'btn-primary' : 'btn-outline-primary' %> btn-sm px-3"> مخزن المستديم</a>
                <a href="/manager/items?store=كيماويات" class="btn <%= selectedStore === 'كيماويات' ? 'btn-primary' : 'btn-outline-primary' %> btn-sm px-3"> مخزن الكيماويات</a>
            </div>
        </div>

        <!-- جدول الأصناف -->
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center no-print">
                <span>أصناف (<%= selectedStore === 'الكل' ? 'جميع المخازن' : selectedStore %>)</span>
                <span class="badge bg-light text-dark">عدد الأصناف: <%= items.length %></span>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-striped table-hover text-center align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>رقم الصنف</th>
                            <th>اسم الصنف</th>
                            <th>المخزن</th>
                            <th>الكمية الإجمالية</th>
                            <th>الكمية المتاحة</th>
                            <th>سعر الوحدة</th>
                            <th>الإجمالي</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (items && items.length > 0) { %>
                            <% items.forEach((item, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><strong><%= item.item_number %></strong></td>
                                    <td><%= item.item_name %></td>
                                    <td><%= item.store_type || 'مستهلك' %></td>
                                    <td><%= item.quantity %></td>
                                    <td><%= item.available_quantity %></td>
                                    <td><%= (parseFloat(item.price) || 0).toFixed(2) %> ج.م</td>
                                    <td><strong><%= ((parseFloat(item.available_quantity) || 0) * (parseFloat(item.price) || 0)).toFixed(2) %> ج.م</strong></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-muted py-4">لا توجد أصناف مضافة في <%= selectedStore === 'الكل' ? 'المخازن' : selectedStore %> حتى الآن.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>