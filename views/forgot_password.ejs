<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>نسيت كلمة السر</title>
    <style>
        body { font-family: Tahoma, sans-serif; background-color: #f4f6f9; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .card { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); width: 380px; }
        h2 { text-align: center; color: #333; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; color: #666; }
        input { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; }
        button { width: 100%; background: #28a745; color: white; border: none; padding: 10px; border-radius: 4px; font-size: 16px; cursor: pointer; }
        button:hover { background: #218838; }
        .error { color: red; font-size: 13px; text-align: center; margin-bottom: 10px; }
        .success { color: green; font-size: 13px; text-align: center; margin-bottom: 10px; }
        .back-link { text-align: center; margin-top: 15px; }
        .back-link a { color: #007bff; text-decoration: none; font-size: 14px; }
    </style>
</head>
<body>

<div class="card">
    <h2>استعادة كلمة السر</h2>
    <% if (error) { %> <div class="error"><%= error %></div> <% } %>
    <% if (success) { %> <div class="success"><%= success %></div> <% } %>
    
    <form action="/forgot-password" method="POST">
        <div class="form-group">
            <label>اسم المستخدم</label>
            <input type="text" name="username" required>
        </div>
        <div class="form-group">
            <label>رقم التليفون أو البريد الإلكتروني</label>
            <input type="text" name="phone_or_email" required>
        </div>
        <div class="form-group">
            <label>كلمة السر الجديدة</label>
            <input type="password" name="new_password" required>
        </div>
        <button type="submit">تأكيد وتغيير كلمة السر</button>
    </form>
    <div class="back-link">
        <a href="/login">العودة لتسجيل الدخول</a>
    </div>
</div>

</body>
</html>